# ==============================================================================
# APROBADOS YA - VARIABLES DE ENTORNO
# ==============================================================================
# Instrucciones:
# 1. Copia este archivo y renómbralo a `.env`
# 2. Rellena los valores reales de tus cuentas de Supabase y Stripe.
# 3. NUNCA subas el archivo `.env` a repositorios públicos ni expongas las claves secretas.

# ------------------------------------------------------------------------------
# SUPABASE
# Estas variables deben inyectarse en el frontend (ej: a través de Vite o Vercel)
# ------------------------------------------------------------------------------
SUPABASE_URL=tu_supabase_project_url_aqui
SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# (Opcional por ahora) Sólo necesario si usas el cliente de administración en el backend
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_aqui

# ------------------------------------------------------------------------------
# STRIPE
# ------------------------------------------------------------------------------
# Clave pública para usar en el frontend (Stripe Checkout)
STRIPE_PUBLISHABLE_KEY=tu_stripe_publishable_key_aqui

# Clave secreta para el backend (Crear sesiones de pago, verificar webhooks)
STRIPE_SECRET_KEY=tu_stripe_secret_key_aqui

# Secreto del webhook para verificar que los eventos vienen realmente de Stripe
STRIPE_WEBHOOK_SECRET=tu_stripe_webhook_secret_aqui
