# ============================================================
# APROBADOS YA — Variables de Entorno
# Copia este archivo como .env.local para desarrollo local
# En producción, configúralas en el panel de Vercel
# ============================================================

# ── PÚBLICAS (seguras para frontend con RLS activo) ──────────
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_clave_anon_publica_aqui

# ── SECRETAS (SOLO BACKEND / VERCEL SERVERLESS) ─────────────
# NUNCA incluir estas claves en index.html, app_v2.js o auth.js
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
